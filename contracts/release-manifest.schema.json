{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clovermoss.dev/schemas/release-manifest.schema.json",
  "title": "CloverMoss release manifest",
  "description": "Fetched by the launcher at startup from the repository's /release folder. The `signature` field is an Ed25519 signature over the canonical JSON of every other field (keys sorted, no whitespace), hex or base64 encoded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app", "sources"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "version"],
      "properties": {
        "name": { "type": "string", "default": "CloverMoss Launcher" },
        "channel": { "type": "string", "enum": ["stable", "beta"] },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "min_supported": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
          "description": "Clients older than this are told to update before using the launcher."
        },
        "published_at": { "type": "string", "format": "date-time" },
        "notes_url": { "type": "string", "format": "uri" },
        "rollout": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Fraction of installs (sticky by install id) offered this build."
        }
      }
    },
    "announcements": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
          "level": { "type": "string", "enum": ["info", "success", "warning", "critical"] },
          "title": { "type": "string", "maxLength": 120 },
          "body_markdown": { "type": "string", "maxLength": 20000 },
          "body_url": { "type": "string", "format": "uri" },
          "starts_at": { "type": "string", "format": "date-time" },
          "ends_at": { "type": ["string", "null"], "format": "date-time" },
          "dismissible": { "type": "boolean", "default": true },
          "pinned": { "type": "boolean", "default": false },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "maxLength": 40 },
              "url": { "type": "string", "format": "uri" },
              "kind": { "type": "string", "enum": ["open_url", "check_update", "open_settings"] }
            }
          }
        },
        "oneOf": [{ "required": ["body_markdown"] }, { "required": ["body_url"] }]
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "arch", "url", "size", "sha256", "kind"],
        "properties": {
          "platform": { "type": "string", "enum": ["darwin", "win32", "linux"] },
          "arch": { "type": "string", "enum": ["arm64", "x64", "universal"] },
          "kind": { "type": "string", "enum": ["dmg", "zip", "exe", "msi", "appimage", "deb"] },
          "url": { "type": "string", "format": "uri" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "min_os": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moss"],
      "properties": {
        "moss": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "branch"],
          "properties": {
            "repo": { "type": "string", "format": "uri" },
            "branch": { "type": "string", "default": "main" },
            "recommended_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{7,40}$",
              "description": "Commit the maintainers have validated. Marked as stable alongside main HEAD."
            }
          }
        },
        "git_mirrors": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "description": "Prefixes such as https://ghproxy.net/https://github.com/."
        },
        "pip_indexes": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "hf_endpoints": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "manifest_mirrors": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "python_builds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "platform", "arch", "url", "sha256"],
            "properties": {
              "version": { "type": "string" },
              "platform": { "type": "string", "enum": ["darwin", "win32", "linux"] },
              "arch": { "type": "string", "enum": ["arm64", "x64"] },
              "url": { "type": "string", "format": "uri" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "models_url": { "type": "string", "format": "uri" },
        "rules_url": { "type": "string", "format": "uri" }
      }
    },
    "signature": {
      "type": "string",
      "description": "Ed25519 signature over canonical JSON without this field."
    }
  }
}
